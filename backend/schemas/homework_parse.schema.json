{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HomeworkParseResponseV4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject",
    "question_meaning_zh",
    "question_blocks",
    "answer_items",
    "student_answer_reviews",
    "solution_steps",
    "explanation_zh",
    "learning_points",
    "uncertainty"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "4.0"
    },
    "subject": {
      "type": "string",
      "enum": ["general", "english", "liberal_arts", "science"]
    },
    "question_meaning_zh": {
      "type": "string",
      "minLength": 1
    },
    "question_blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["block_id", "order", "title", "question_meaning_zh", "content_items"],
        "properties": {
          "block_id": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "question_meaning_zh": {
            "type": "string",
            "minLength": 1
          },
          "content_items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/content_item"
            }
          }
        }
      }
    },
    "answer_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "answer_id",
          "block_id",
          "order",
          "number",
          "answer_type",
          "plain_text",
          "speak_text",
          "display"
        ],
        "properties": {
          "answer_id": {
            "type": "string",
            "minLength": 1
          },
          "block_id": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "number": {
            "type": ["string", "null"]
          },
          "answer_type": {
            "$ref": "#/$defs/answer_type"
          },
          "plain_text": {
            "type": "string",
            "minLength": 1
          },
          "speak_text": {
            "type": ["string", "null"]
          },
          "display": {
            "$ref": "#/$defs/answer_display"
          }
        }
      }
    },
    "student_answer_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "review_id",
          "block_id",
          "answer_id",
          "order",
          "number",
          "student_answer",
          "correct_answer",
          "status",
          "feedback_zh",
          "confidence"
        ],
        "properties": {
          "review_id": {
            "type": "string",
            "minLength": 1
          },
          "block_id": {
            "type": "string",
            "minLength": 1
          },
          "answer_id": {
            "type": ["string", "null"]
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "number": {
            "type": ["string", "null"]
          },
          "student_answer": {
            "type": ["string", "null"]
          },
          "correct_answer": {
            "type": ["string", "null"]
          },
          "status": {
            "type": "string",
            "enum": [
              "correct",
              "incorrect",
              "partially_correct",
              "unanswered",
              "unclear",
              "not_applicable"
            ]
          },
          "feedback_zh": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "solution_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["block_id", "number", "title", "content_zh", "formula", "result"],
        "properties": {
          "block_id": {
            "type": "string",
            "minLength": 1
          },
          "number": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "content_zh": {
            "type": "string",
            "minLength": 1
          },
          "formula": {
            "type": ["string", "null"]
          },
          "result": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "explanation_zh": {
      "type": "string",
      "minLength": 1
    },
    "learning_points": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["block_id", "term", "explanation_zh", "pronunciation", "category"],
        "properties": {
          "block_id": {
            "type": ["string", "null"]
          },
          "term": {
            "type": "string",
            "minLength": 1
          },
          "explanation_zh": {
            "type": "string",
            "minLength": 1
          },
          "pronunciation": {
            "type": ["string", "null"]
          },
          "category": {
            "type": "string",
            "enum": ["word", "concept", "formula", "unit", "method", "other"]
          },
          "label": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires_review", "confidence", "reason"],
      "properties": {
        "requires_review": {
          "type": "boolean"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reason": {
          "type": ["string", "null"]
        }
      }
    }
  },
  "$defs": {
    "content_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "order",
        "group_id",
        "type",
        "text",
        "meaning_zh",
        "language",
        "speak_text",
        "speakable"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "group_id": {
          "type": ["string", "null"]
        },
        "type": {
          "type": "string",
          "enum": [
            "instruction",
            "example",
            "context",
            "material",
            "dialogue",
            "word_bank",
            "option",
            "image_text",
            "other"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "meaning_zh": {
          "type": ["string", "null"]
        },
        "language": {
          "type": "string",
          "enum": ["zh", "en", "mixed", "unknown"]
        },
        "speak_text": {
          "type": ["string", "null"]
        },
        "speakable": {
          "type": "boolean"
        }
      }
    },
    "answer_type": {
      "type": "string",
      "enum": [
        "fill_blank",
        "choice",
        "picture_word",
        "matching",
        "sentence_ordering",
        "reading_qa",
        "translation",
        "correction",
        "copying",
        "calculation",
        "proof",
        "short_answer",
        "composition",
        "pinyin",
        "other"
      ]
    },
    "answer_display": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "format", "latex", "preserve_newlines", "runs"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "inline_segments",
            "math_block",
            "paragraph",
            "choice",
            "matching",
            "table",
            "pinyin",
            "copying",
            "plain"
          ]
        },
        "format": {
          "type": "string",
          "enum": ["plain_text", "plain_math", "latex", "vertical_calculation", "table"]
        },
        "latex": {
          "type": ["string", "null"]
        },
        "preserve_newlines": {
          "type": "boolean"
        },
        "runs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "role"],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string",
                "enum": ["given", "answer", "connector", "correction", "student_answer"]
              }
            }
          }
        }
      }
    }
  }
}
