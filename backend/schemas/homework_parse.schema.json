{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HomeworkParseResponseV3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subject",
    "question_meaning_zh",
    "question_instruction",
    "question_blocks",
    "answer_lines",
    "solution_steps",
    "explanation_zh",
    "learning_points",
    "read_units",
    "uncertainty"
  ],
  "properties": {
    "subject": {
      "type": "string",
      "enum": ["general", "english", "liberal_arts", "science"]
    },
    "question_meaning_zh": {
      "type": "string",
      "minLength": 1
    },
    "question_instruction": {
      "$ref": "#/$defs/question_instruction"
    },
    "question_blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "block_id",
          "title",
          "question_instruction",
          "question_meaning_zh"
        ],
        "properties": {
          "block_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "question_instruction": {
            "$ref": "#/$defs/question_instruction"
          },
          "question_meaning_zh": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "answer_lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["block_id", "number", "line_type", "plain_text", "segments"],
        "properties": {
          "block_id": {
            "type": "string",
            "minLength": 1
          },
          "number": {
            "type": ["string", "null"]
          },
          "line_type": {
            "type": "string",
            "enum": [
              "fill_blank",
              "choice",
              "picture_word",
              "matching",
              "sentence_ordering",
              "reading_qa",
              "translation",
              "correction",
              "copying",
              "calculation",
              "proof",
              "short_answer",
              "composition",
              "pinyin",
              "other"
            ]
          },
          "plain_text": {
            "type": "string",
            "minLength": 1
          },
          "segments": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["text", "role"],
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "role": {
                  "type": "string",
                  "enum": ["given", "answer", "connector", "correction"]
                }
              }
            }
          }
        }
      }
    },
    "solution_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["block_id", "number", "title", "content_zh", "formula", "result"],
        "properties": {
          "block_id": {
            "type": "string",
            "minLength": 1
          },
          "number": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "content_zh": {
            "type": "string",
            "minLength": 1
          },
          "formula": {
            "type": ["string", "null"]
          },
          "result": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "explanation_zh": {
      "type": "string",
      "minLength": 1
    },
    "learning_points": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["block_id", "term", "explanation_zh", "pronunciation", "category"],
        "properties": {
          "block_id": {
            "type": ["string", "null"]
          },
          "term": {
            "type": "string",
            "minLength": 1
          },
          "explanation_zh": {
            "type": "string",
            "minLength": 1
          },
          "pronunciation": {
            "type": ["string", "null"]
          },
          "category": {
            "type": "string",
            "enum": ["word", "concept", "formula", "unit", "method", "other"]
          },
          "label": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "read_units": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["block_id", "unit_type", "text", "meaning_zh"],
        "properties": {
          "block_id": {
            "type": ["string", "null"]
          },
          "unit_type": {
            "type": "string",
            "enum": ["word", "text"]
          },
          "label": {
            "type": ["string", "null"]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "meaning_zh": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires_review", "confidence", "reason"],
      "properties": {
        "requires_review": {
          "type": "boolean"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reason": {
          "type": ["string", "null"]
        }
      }
    }
  },
  "$defs": {
    "question_instruction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "meaning_zh", "confidence"],
      "properties": {
        "text": {
          "type": "string"
        },
        "meaning_zh": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
