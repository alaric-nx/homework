{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HomeworkParseResponseV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "question_meaning_zh",
    "question_instruction",
    "question_blocks",
    "answer_lines",
    "explanation_zh",
    "key_vocabulary",
    "speak_units",
    "uncertainty"
  ],
  "properties": {
    "question_meaning_zh": {
      "type": "string",
      "minLength": 1
    },
    "question_instruction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "meaning_zh", "confidence"],
      "properties": {
        "text": {
          "type": "string"
        },
        "meaning_zh": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "question_blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "block_id",
          "title",
          "question_instruction",
          "question_meaning_zh"
        ],
        "properties": {
          "block_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "question_instruction": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "meaning_zh", "confidence"],
            "properties": {
              "text": {
                "type": "string"
              },
              "meaning_zh": {
                "type": "string"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "question_meaning_zh": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "answer_lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["block_id", "number", "line_type", "plain_text", "segments"],
        "properties": {
          "block_id": {
            "type": "string",
            "minLength": 1
          },
          "number": {
            "type": ["string", "null"]
          },
          "line_type": {
            "type": "string",
            "enum": [
              "fill_blank",
              "choice",
              "picture_word",
              "matching",
              "sentence_ordering",
              "reading_qa",
              "translation",
              "correction",
              "copying",
              "other"
            ]
          },
          "plain_text": {
            "type": "string",
            "minLength": 1
          },
          "segments": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["text", "role"],
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "role": {
                  "type": "string",
                  "enum": ["given", "answer", "connector", "correction"]
                }
              }
            }
          }
        }
      }
    },
    "explanation_zh": {
      "type": "string",
      "minLength": 1
    },
    "key_vocabulary": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["word", "meaning_zh"],
        "properties": {
          "word": {
            "type": "string",
            "minLength": 1
          },
          "meaning_zh": {
            "type": "string",
            "minLength": 1
          },
          "ipa": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "speak_units": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["unit_type", "text"],
        "properties": {
          "unit_type": {
            "type": "string",
            "enum": ["word", "sentence"]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "meaning_zh": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires_review", "confidence"],
      "properties": {
        "requires_review": {
          "type": "boolean"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reason": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
